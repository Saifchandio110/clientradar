{
  "name": "clientradar",
  "keep_vars": true,
  "triggers": { "crons": ["*/2 * * * *"] },
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientradar-db",
      "database_id": "df6d9a4d-343b-4cf0-bc81-7aafbcae5f68"
    }
  ]
}
